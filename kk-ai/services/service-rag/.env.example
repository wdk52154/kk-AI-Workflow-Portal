# RAG Service Configuration

# Service
SERVICE_NAME=service-rag
VERSION=0.1.0
PORT=9002
DEBUG=true
LOG_LEVEL=INFO

# LLM Gateway (for Embedding + Rerank)
LLM_GATEWAY_URL=http://localhost:9001

# Vector Store
VECTOR_STORE_TYPE=memory  # memory | chromadb
VECTOR_STORE_PERSIST_DIR=./chroma_data

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Search
DEFAULT_TOP_K=5
MAX_TOP_K=50

# Document Upload
MAX_FILE_SIZE_MB=10
MAX_CHUNKS_PER_DOC=1000
